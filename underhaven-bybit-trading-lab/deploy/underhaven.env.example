# /etc/underhaven/underhaven.env
# Read by systemd. Keep mode 0640 root:underhaven. No secrets are required
# here: the session key lives in the data directory and the AES master key is
# read from UNDERHAVEN_MASTER_KEY_FILE outside SQLite.

UNDERHAVEN_DATA_DIR=/var/lib/underhaven
UNDERHAVEN_DB_PATH=/var/lib/underhaven/underhaven.db
UNDERHAVEN_MASTER_KEY_FILE=/etc/underhaven/master.key
UNDERHAVEN_BIND=127.0.0.1:8080
UNDERHAVEN_SECURE_COOKIES=true
UNDERHAVEN_PUBLIC_URL=https://203.0.113.10
UNDERHAVEN_TLS_MODE=letsencrypt

# Public market data only. Override for testnet/read-only research if desired.
UNDERHAVEN_REST_BASE=https://api.bybit.com
UNDERHAVEN_WS_URL=wss://stream.bybit.com/v5/public/linear

# Scanner / risk defaults. All values are validated at startup.
UNDERHAVEN_SYMBOLS=BTCUSDT,ETHUSDT,SOLUSDT,XRPUSDT,DOGEUSDT
UNDERHAVEN_MAX_SYMBOLS=12
UNDERHAVEN_PRIMARY_INTERVAL=5m
UNDERHAVEN_SCANNER_REFRESH_SECS=120
UNDERHAVEN_MAX_SPREAD_BPS=8
UNDERHAVEN_MIN_DEPTH_USD=25000
UNDERHAVEN_MAX_STALENESS_MS=5000
UNDERHAVEN_TAKER_FEE_BPS=7.5
UNDERHAVEN_SLIPPAGE_BPS=4

UNDERHAVEN_AUTO_START=true
UNDERHAVEN_LOGIN_MAX_ATTEMPTS=5
UNDERHAVEN_LOGIN_WINDOW_SECS=900
RUST_LOG=info,underhaven=info,tower_http=warn
